static func install() -> void:
	if "zh_CN" in TranslationServer.get_loaded_locales(): return
	var english := Translation.new()
	english.locale = "en"
	var chinese := Translation.new()
	chinese.locale = "zh_CN"
	for en: String in PAIRS:
		var zh: String = PAIRS[en]
		english.add_message(en,en)
		english.add_message(zh,en)
		chinese.add_message(en,zh)
		chinese.add_message(zh,zh)
	TranslationServer.add_translation(english)
	TranslationServer.add_translation(chinese)
